# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Media pesante — NON committare video/foto nel repo
# I file restano sul server (Railway volume o CDN)
public/videos/
public/fotos/
fotos/
*.mp4
*.mov
*.avi
*.webm

# Permititi: piccoli video del sito
!public/videos/sito/
!public/videos/sito/**/*.mp4
!public/videos/sito/**/*.jpg
!public/videos/dicono/
!public/videos/dicono/**/*.mp4
!public/videos/dicono/**/*.jpg
